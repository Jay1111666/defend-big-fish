    <script>
      window.gameReady = false;
      window.gameLoadError = '';
      const loadingStarted = Date.now();
      const loadPoll = setInterval(() => {
        if(window.gameLoadError) {
          document.getElementById('load-message').textContent = window.gameLoadError;
          document.getElementById('game-loader').hidden = false;
          clearInterval(loadPoll);
        } else if(window.gameReady) {
          document.getElementById('game-loader').hidden = true;
          document.getElementById('canvas').focus();
          clearInterval(loadPoll);
        } else if(Date.now()-loadingStarted > 45000) {
          document.getElementById('load-message').textContent = '首次加载可能较慢，请继续等待。若长时间无响应，请刷新或更换网络。';
        }
      }, 250);
    </script>


