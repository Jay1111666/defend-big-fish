+def draw_burn_flames(surface, enemy, tick, scale=1):
+    if enemy.active_burn is None:
+        return
+    x, y = enemy.position
+    for i in range(3):
+        cx = x + (i - 1) * 12 * scale
+        bottom = y + 22 * scale
+        height = (18 + 5 * math.sin(tick * 12 + i * 2)) * scale
+        width = 7 * scale
+        tip = (cx + math.sin(tick * 8 + i) * 3 * scale, bottom - height)
+        pygame.draw.polygon(surface, (245, 111, 39),
+                            [(cx - width, bottom), (cx - width, bottom - height * .4),
+                             tip, (cx + width, bottom - height * .3), (cx + width, bottom)])
+        pygame.draw.polygon(surface, (255, 232, 100),
+                            [(cx - width * .45, bottom), (cx, bottom - height * .65),
+                             (cx + width * .45, bottom)])
+
